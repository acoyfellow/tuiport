{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tuiport",
  "main": "build/worker.bundled.mjs",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // RELAY_TOKEN and SSH_HOST_KEY_B64 are NOT required to deploy. The site and
  // browser demo run with no secrets; `/bridge` stays closed (401) and the
  // Container uses an ephemeral host key until `bun run setup` enables public
  // SSH. This keeps first deploy zero-config.
  "build": { "command": "bun run build" },
  "containers": [
    {
      "name": "tuiport-app",
      "class_name": "TuiportContainer",
      "image": "./container/Dockerfile",
      "image_build_context": ".",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TUIPORT", "class_name": "TuiportContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TuiportContainer"] }]
}
